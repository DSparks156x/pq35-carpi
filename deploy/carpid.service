# User service, so carpid and LIVI run as the same user and share the API
# socket ($XDG_RUNTIME_DIR/carpid.sock). Needs lingering for the user:
#   loginctl enable-linger $USER
# Installed from the bundle's share/systemd/user by os/install.sh.
[Unit]
Description=rnse-carpi car daemon
After=network.target

[Service]
ExecStart=/opt/carpi/current/bin/carpid --config %h/.config/carpi/carpid.toml
Restart=always
RestartSec=1
Environment=RUST_LOG=info

[Install]
WantedBy=default.target
